{
  "name": "moneytrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.cjs",
    "test:accounts": "node scripts/account-smoke.cjs",
    "test:admin": "node scripts/admin-smoke.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:sms": "node scripts/sms-smoke.cjs",
    "test:sms-install": "node scripts/sms-install-smoke.cjs",
    "test:update": "node scripts/update-smoke.cjs",
    "test:classification": "node scripts/classification-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
