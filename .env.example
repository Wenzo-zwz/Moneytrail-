# Supabase 前端公开配置，会进入浏览器构建产物。
# 复制为 .env.local 后填写自己的项目连接信息。
# 不要填写 service_role、sb_secret_ 开头的 Secret key、数据库密码或访问令牌。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 仅旧版项目可用 anon public key 替代 Publishable key；两者任选一种。
# VITE_SUPABASE_ANON_KEY=

# GitHub Pages 的仓库子路径由部署工作流设置。
# 普通根路径托管不需要设置 MONEYTRAIL_BASE_PATH。
